# Visual Studio user specific files & project files
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# JetBrains Rider & IntelliJ
.idea/
*.sln.DotSettings.user
*.DotSettings.user
cmake-build-*/

# Visual Studio Code & generated project files
.vscode/
*.code-workspace
Makefile
CMakeLists.txt
*.xcodeproj
*.xcworkspace

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*
Plugins/**/Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
Plugins/**/DerivedDataCache/*

# Logs, Dumps, Crash reports
*.log
*.dmp
*.crash

# OS generated files
.DS_Store
Thumbs.db
.ignore
